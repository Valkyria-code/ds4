@model Aquí_sí_Sabe.Models.Receta

@{
    ViewBag.Title = "Detalle de Receta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userId = Session["UserId"];
    var isOwner = userId != null && (int)userId == Model.UsuarioId;
}

<style>
    .recipe-detail-container {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

    .recipe-image {
        width: 100%;
        height: 400px;
        object-fit: cover;
    }

    .recipe-content {
        padding: 2rem;
    }

    .recipe-header {
        border-bottom: 3px solid #F4D03F;
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
    }

    .recipe-title {
        font-size: 2.5rem;
        font-weight: bold;
        color: #2C3E50;
        margin-bottom: 1rem;
    }

    .recipe-meta {
        display: flex;
        gap: 2rem;
        color: #7F8C8D;
        flex-wrap: wrap;
    }

        .recipe-meta span {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .category-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, #F4D03F, #F39C12);
        color: #2C3E50;
        border-radius: 20px;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }

    .btn-favorite {
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        font-weight: 600;
        border: none;
        transition: all 0.3s;
    }

        .btn-favorite.not-favorite {
            background-color: #ECF0F1;
            color: #7F8C8D;
        }

        .btn-favorite.is-favorite {
            background-color: #E74C3C;
            color: white;
        }

        .btn-favorite:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    .section-title {
        font-size: 1.8rem;
        font-weight: bold;
        color: #2C3E50;
        margin: 2rem 0 1rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .ingredients-list {
        list-style: none;
        padding: 0;
    }

        .ingredients-list li {
            padding: 0.75rem;
            background-color: #FFFEF7;
            margin-bottom: 0.5rem;
            border-left: 4px solid #F39C12;
            border-radius: 5px;
        }

    .steps-list {
        counter-reset: step-counter;
        list-style: none;
        padding: 0;
    }

        .steps-list li {
            counter-increment: step-counter;
            padding: 1.5rem;
            background-color: white;
            margin-bottom: 1rem;
            border: 2px solid #ECF0F1;
            border-radius: 10px;
            position: relative;
            padding-left: 4rem;
        }

            .steps-list li::before {
                content: counter(step-counter);
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                background: linear-gradient(135deg, #F4D03F, #F39C12);
                color: #2C3E50;
                width: 2.5rem;
                height: 2.5rem;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.2rem;
            }
</style>

<div class="recipe-detail-container">
    <img src="@(Model.DireccionImagen ?? "https://via.placeholder.com/800x400?text=Receta")" alt="@Model.Titulo" class="recipe-image">

    <div class="recipe-content">
        <div class="recipe-header">
            <div class="category-badge">@Model.Categoria</div>
            <h1 class="recipe-title">@Model.Titulo</h1>

            <div class="recipe-meta">
                <span><i class="fas fa-user"></i> @(Model.NombreUsuario ?? "Anónimo")</span>
                <span><i class="fas fa-calendar"></i> @Model.FechaCreacion.ToString("dd/MM/yyyy")</span>
                <span><i class="fas fa-eye"></i> @Model.Vistas vistas</span>
            </div>

            <div class="action-buttons">
                @if (userId != null)
                {
                    if (Model.EsFavorito)
                    {
                        using (Html.BeginForm("Remove", "Favorito", FormMethod.Post, new { @class = "d-inline" }))
                        {
                            <input type="hidden" name="recetaId" value="@Model.RecetaId" />
                            <button type="submit" class="btn btn-favorite is-favorite">
                                <i class="fas fa-heart"></i> Quitar de Favoritos
                            </button>
                        }
                    }
                    else
                    {
                        using (Html.BeginForm("Add", "Favorito", FormMethod.Post, new { @class = "d-inline" }))
                        {
                            <input type="hidden" name="recetaId" value="@Model.RecetaId" />
                            <button type="submit" class="btn btn-favorite not-favorite">
                                <i class="fas fa-heart"></i> Agregar a Favoritos
                            </button>
                        }
                    }
                }

                @if (isOwner)
                {
                    <a href="@Url.Action("Edit", "Receta", new { id = Model.RecetaId })" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Editar
                    </a>

                    using (Html.BeginForm("Delete", "Receta", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('¿Estás seguro de eliminar esta receta?');" }))
                    {
                        <input type="hidden" name="id" value="@Model.RecetaId" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Eliminar
                        </button>
                    }
                }
            </div>
        </div>

        <div class="section-title">
            <i class="fas fa-align-left"></i> Descripción
        </div>
        <p>@Model.Descripcion</p>

        <div class="section-title">
            <i class="fas fa-list"></i> Ingredientes
        </div>
        <ul class="ingredients-list">
            @foreach (var ingrediente in Model.Ingredientes.Split('|').Where(i => !string.IsNullOrWhiteSpace(i)))
            {
                <li><i class="fas fa-check"></i> @ingrediente</li>
            }
        </ul>

        <div class="section-title">
            <i class="fas fa-book-open"></i> Pasos de Preparación
        </div>
        <ol class="steps-list">
            @foreach (var paso in Model.Pasos.Split('|').Where(p => !string.IsNullOrWhiteSpace(p)))
            {
                <li>@paso</li>
            }
        </ol>
    </div>
</div>