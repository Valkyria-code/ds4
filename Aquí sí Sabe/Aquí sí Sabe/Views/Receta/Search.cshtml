@model List<Aquí_sí_Sabe.Models.Receta>

@{
    ViewBag.Title = "Buscar Recetas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .search-header {
        text-align: center;
        margin-bottom: 3rem;
    }

        .search-header h1 {
            color: #2C3E50;
            font-weight: bold;
        }

    .search-query {
        color: #F39C12;
        font-weight: 600;
    }

    .recipe-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: all 0.3s;
        cursor: pointer;
        height: 100%;
        text-decoration: none;
        color: inherit;
        display: block;
    }

        .recipe-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .recipe-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

    .recipe-card-body {
        padding: 1.5rem;
    }

    .recipe-card-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #2C3E50;
        margin-bottom: 0.5rem;
    }

    .recipe-card-stats {
        display: flex;
        justify-content: space-between;
        color: #7F8C8D;
        font-size: 0.9rem;
        border-top: 1px solid #ECF0F1;
        padding-top: 0.75rem;
        margin-top: 1rem;
    }

    .category-badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        background-color: #F4D03F;
        color: #2C3E50;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .no-results {
        text-align: center;
        padding: 4rem 2rem;
        color: #7F8C8D;
    }

        .no-results i {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: #ECF0F1;
        }
</style>

<div class="container">
    <div class="search-header">
        <h1><i class="fas fa-search"></i> Resultados de Búsqueda</h1>
        <p>Buscando: <span class="search-query">"@ViewBag.Query"</span></p>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var receta in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <a href="@Url.Action("Details", "Receta", new { id = receta.RecetaId })" class="recipe-card">
                        <img src="@(receta.DireccionImagen ?? "https://via.placeholder.com/400x300?text=Receta")" alt="@receta.Titulo">
<div class="recipe-card-body">
<div class="category-badge">@receta.Categoria</div>
<div class="recipe-card-title">@receta.Titulo</div>
<div class="recipe-card-stats">
<span><i class="fas fa-eye"></i> @receta.Vistas</span>
<span><i class="fas fa-user"></i> @(receta.NombreUsuario ?? "Anónimo")</span>
</div>
</div>
</a>
</div>
}
}
else
{
<div class="col-12">
<div class="no-results">
<i class="fas fa-search"></i>
<p>No se encontraron recetas con el término "@ViewBag.Query"</p>
<a href="@Url.Action("Index", "Receta")" class="btn btn-primary mt-3">
<i class="fas fa-arrow-left"></i> Ver todas las recetas
</a>
</div>
</div>
}
</div>
</div>
```
