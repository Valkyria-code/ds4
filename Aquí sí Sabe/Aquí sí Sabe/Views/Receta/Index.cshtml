@model List<Aquí_sí_Sabe.Models.Receta>

@{
    ViewBag.Title = "Explorar Recetas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .filters-section {
        background: white;
        padding: 1.5rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    }

    .filter-group {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .filter-select {
        border: 2px solid #ECF0F1;
        border-radius: 10px;
        padding: 0.5rem 1rem;
        min-width: 200px;
    }

    .recipe-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: all 0.3s;
        cursor: pointer;
        height: 100%;
        text-decoration: none;
        color: inherit;
        display: block;
    }

        .recipe-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .recipe-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

    .recipe-card-body {
        padding: 1.5rem;
    }

    .recipe-card-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #2C3E50;
        margin-bottom: 0.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .recipe-card-description {
        color: #7F8C8D;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .recipe-card-stats {
        display: flex;
        justify-content: space-between;
        color: #7F8C8D;
        font-size: 0.9rem;
        border-top: 1px solid #ECF0F1;
        padding-top: 0.75rem;
    }

    .category-badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        background-color: #F4D03F;
        color: #2C3E50;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .no-results {
        text-align: center;
        padding: 4rem 2rem;
        color: #7F8C8D;
    }

        .no-results i {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: #ECF0F1;
        }
</style>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-book"></i> Todas las Recetas</h1>
    </div>

    <!-- Filters Section -->
    <div class="filters-section">
        @using (Html.BeginForm("Index", "Receta", FormMethod.Get, new { @class = "filter-group" }))
        {
            <label><strong>Filtrar por:</strong></label>
            <select name="category" class="filter-select" onchange="this.form.submit()">
                <option value="">Todas las categorías</option>
                <option value="Postres" @(ViewBag.SelectedCategory == "Postres" ? "selected" : "")>Postres</option>
                <option value="Platos Principales" @(ViewBag.SelectedCategory == "Platos Principales" ? "selected" : "")>Platos Principales</option>
                <option value="Bebidas" @(ViewBag.SelectedCategory == "Bebidas" ? "selected" : "")>Bebidas</option>
                <option value="Ensaladas" @(ViewBag.SelectedCategory == "Ensaladas" ? "selected" : "")>Ensaladas</option>
                <option value="Sopas" @(ViewBag.SelectedCategory == "Sopas" ? "selected" : "")>Sopas</option>
                <option value="Entradas" @(ViewBag.SelectedCategory == "Entradas" ? "selected" : "")>Entradas</option>
            </select>

            if (!string.IsNullOrEmpty(ViewBag.SelectedCategory as string))
            {
                <a href="@Url.Action("Index", "Receta")" class="btn btn-outline-secondary">
                    <i class="fas fa-times"></i> Limpiar
                </a>
            }
        }
    </div>

    <!-- Recipes Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var receta in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <a href="@Url.Action("Details", "Receta", new { id = receta.RecetaId })" class="recipe-card">
                        <img src="@(receta.DireccionImagen ?? "https://via.placeholder.com/400x300?text=Receta")" alt="@receta.Titulo">
                        <div class="recipe-card-body">
                            <div class="category-badge">@receta.Categoria</div>
                            <div class="recipe-card-title">@receta.Titulo</div>
                            <div class="recipe-card-description">@(receta.Descripcion ?? "")</div>
                            <div class="recipe-card-stats">
                                <span><i class="fas fa-eye"></i> @receta.Vistas</span>
                                <span><i class="fas fa-user"></i> @(receta.NombreUsuario ?? "Anónimo")</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="no-results">
                    <i class="fas fa-search"></i>
                    <p>No se encontraron recetas</p>
                </div>
            </div>
        }
    </div>
</div>