@model List<Aquí_sí_Sabe.Models.Receta>

@{
    ViewBag.Title = "Mis Favoritos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .favorites-header {
        text-align: center;
        margin-bottom: 3rem;
        padding: 2rem;
        background: linear-gradient(135deg, #F4D03F, #F39C12);
        border-radius: 20px;
    }

        .favorites-header h1 {
            color: #2C3E50;
            font-weight: bold;
            margin: 0;
        }

        .favorites-header p {
            color: #34495E;
            margin: 0.5rem 0 0 0;
        }

    .recipe-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: all 0.3s;
        height: 100%;
        text-decoration: none;
        color: inherit;
        display: block;
    }

        .recipe-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .recipe-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

    .recipe-card-body {
        padding: 1.5rem;
    }

    .recipe-card-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #2C3E50;
        margin-bottom: 0.5rem;
    }

    .recipe-card-stats {
        display: flex;
        justify-content: space-between;
        color: #7F8C8D;
        font-size: 0.9rem;
        border-top: 1px solid #ECF0F1;
        padding-top: 0.75rem;
        margin-top: 1rem;
    }

    .category-badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        background-color: #F4D03F;
        color: #2C3E50;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .no-favorites {
        text-align: center;
        padding: 4rem 2rem;
        color: #7F8C8D;
    }

        .no-favorites i {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: #ECF0F1;
        }

    .btn-remove {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(231, 76, 60, 0.9);
        color: white;
        border: none;
        border-radius: 50%;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s;
    }

        .btn-remove:hover {
            background: #E74C3C;
            transform: scale(1.1);
        }

    .recipe-card-wrapper {
        position: relative;
    }
</style>

<div class="container">
    <div class="favorites-header">
        <h1><i class="fas fa-heart"></i> Mis Recetas Favoritas</h1>
        <p>Aquí encontrarás todas las recetas que has guardado</p>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var receta in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="recipe-card-wrapper">
                        <a href="@Url.Action("Details", "Receta", new { id = receta.RecetaId })" class="recipe-card">
                            <img src="@(receta.DireccionImagen ?? "https://via.placeholder.com/400x300?text=Receta")" alt="@receta.Titulo">
                            <div class="recipe-card-body">
                                <div class="category-badge">@receta.Categoria</div>
                                <div class="recipe-card-title">@receta.Titulo</div>
                                <div class="recipe-card-stats">
                                    <span><i class="fas fa-eye"></i> @receta.Vistas</span>
                                    <span><i class="fas fa-user"></i> @(receta.NombreUsuario ?? "Anónimo")</span>
                                </div>
                            </div>
                        </a>

                        @using (Html.BeginForm("Remove", "Favorito", FormMethod.Post, new { @class = "d-inline", @style = "position: absolute; top: 10px; right: 10px; z-index: 10;" }))
                        {
                            <input type="hidden" name="recetaId" value="@receta.RecetaId" />
                            <button type="submit" class="btn-remove" title="Quitar de favoritos" onclick="return confirm('¿Quitar esta receta de favoritos?');">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="no-favorites">
                    <i class="fas fa-heart-broken"></i>
                    <p>Aún no tienes recetas favoritas</p>
                    <a href="@Url.Action("Index", "Receta")" class="btn btn-primary mt-3">
                        <i class="fas fa-search"></i> Explorar Recetas
                    </a>
                </div>
            </div>
        }
    </div>
</div>