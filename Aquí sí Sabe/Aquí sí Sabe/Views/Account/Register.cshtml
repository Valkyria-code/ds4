@{
    ViewBag.Title = "Registrarse";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .register-container {
        max-width: 450px;
        margin: 3rem auto;
        background: white;
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .register-header {
        text-align: center;
        margin-bottom: 2rem;
    }

        .register-header h2 {
            color: #2C3E50;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .register-header p {
            color: #7F8C8D;
        }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #2C3E50;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border: 2px solid #ECF0F1;
        border-radius: 10px;
        padding: 0.75rem;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: #F39C12;
            box-shadow: 0 0 0 0.2rem rgba(243, 156, 18, 0.25);
        }

    .btn-register {
        width: 100%;
        padding: 0.75rem;
        background: linear-gradient(135deg, #E74C3C, #C0392B);
        border: none;
        border-radius: 10px;
        color: white;
        font-weight: bold;
        font-size: 1.1rem;
        transition: all 0.3s;
    }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
        }

    .alert {
        border-radius: 10px;
        margin-bottom: 1rem;
    }

    .login-link {
        text-align: center;
        margin-top: 1.5rem;
        color: #7F8C8D;
    }

        .login-link a {
            color: #F39C12;
            font-weight: 600;
            text-decoration: none;
        }

            .login-link a:hover {
                text-decoration: underline;
            }

    .password-requirements {
        font-size: 0.85rem;
        color: #7F8C8D;
        margin-top: 0.5rem;
    }
</style>

<div class="register-container">
    <div class="register-header">
        <h2>🎉 Únete a Aquí sí Sabe</h2>
        <p>Crea tu cuenta gratis</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">@ViewBag.Success</div>
    }

    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
    {
        <div class="form-group">
            <label class="form-label">
                <i class="fas fa-user"></i> Nombre de Usuario
            </label>
            <input type="text" class="form-control" name="username" placeholder="Juan123" required>
        </div>

        <div class="form-group">
            <label class="form-label">
                <i class="fas fa-envelope"></i> Email
            </label>
            <input type="email" class="form-control" name="email" placeholder="tu@email.com" required>
        </div>

        <div class="form-group">
            <label class="form-label">
                <i class="fas fa-lock"></i> Contraseña
            </label>
            <input type="password" class="form-control" name="password" placeholder="••••••••" required>
            <div class="password-requirements">
                Mínimo 6 caracteres
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">
                <i class="fas fa-lock"></i> Confirmar Contraseña
            </label>
            <input type="password" class="form-control" name="confirmPassword" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn btn-register">
            <i class="fas fa-user-plus"></i> Crear Cuenta
        </button>
    }

    <div class="login-link">
        ¿Ya tienes cuenta? <a href="@Url.Action("Login", "Account")">Inicia sesión aquí</a>
    </div>
</div>